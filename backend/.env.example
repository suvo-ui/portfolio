PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/database

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

MEDIA_STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Backblaze B2 remains available as a fallback storage driver.
# MEDIA_STORAGE_DRIVER=b2
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=paper-slayer-media
# Public CDN host for B2. Cloudflare rewrites this host to
# /file/<B2_BUCKET_NAME>/... so app URLs stay clean.
B2_PUBLIC_BASE_URL=https://media.example.com

# R2 is still supported if you later add Cloudflare billing.
# MEDIA_STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=paper-slayer-media
# R2_PUBLIC_BASE_URL=https://media.example.com

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

EMAIL_USER=studio@example.com
EMAIL_PASS=replace-with-email-app-password
RESEND_API_KEY=your-resend-api-key
